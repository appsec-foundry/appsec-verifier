# Python build artifacts
build/
dist/
*.egg-info/
__pycache__/
*.pyc

# Verification run outputs (default output dir)
/verification/

# Hook/runtime artifacts written into the worktree (not project content)
/docs/security/

# Local secrets — never commit (VER-016). Credentials belong in env vars.
*.env
.env

# Sandbox/home environment artifacts that surface in the repo root — not project
# content (shell rc, editor/tool config, git/mcp config, tooling state).
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
/.gitconfig
/.gitmodules
/.mcp.json
/.ripgreprc
/.idea
/.vscode
/.claude/
